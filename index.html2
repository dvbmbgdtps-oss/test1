<!DOCTYPE html>
<html lang="zh-TW" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>婚禮邀請函 | 林上軒 LIN & 徐瑋翎 WEI</title>
    
    <!-- Google Fonts: Cormorant Garamond & Noto Serif TC -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Noto+Serif+TC:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        morandi: {
                            gold: '#d4a373',
                            sage: '#8da399',
                            sand: '#f5ebe0',
                            warmBg: '#fcfaf7',
                            dark: '#3d342f',
                            lightSage: '#eaf0ed',
                            accentGold: '#c08a58'
                        }
                    },
                    fontFamily: {
                        cormorant: ['"Cormorant Garamond"', 'serif'],
                        noto: ['"Noto Serif TC"', 'serif']
                    }
                }
            }
        }
    </script>
    
    <style>
        body {
            font-family: 'Noto Serif TC', serif;
            background-color: #fcfaf7;
            color: #3d342f;
            overflow-x: hidden;
        }

        .font-english {
            font-family: 'Cormorant Garamond', serif;
        }

        /* Glassmorphism navbar */
        .glass-nav {
            background: rgba(252, 250, 247, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }

        /* Soft Glow Card for Timer & Cards */
        .glow-card {
            background: rgba(255, 255, 255, 0.92);
            box-shadow: 0 10px 30px -5px rgba(212, 163, 115, 0.15), 0 4px 12px 0 rgba(0, 0, 0, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(8px);
        }

        /* V-Card Styling */
        .v-card {
            background: #ffffff;
            border-radius: 1.5rem;
            box-shadow: 0 20px 40px -15px rgba(61, 52, 47, 0.07);
            border: 1px solid rgba(212, 163, 115, 0.2);
        }

        /* Accordion transition */
        .accordion-content {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.4s ease-in-out, opacity 0.3s ease-in-out;
            opacity: 0;
        }

        .accordion-content.active {
            max-height: 500px;
            opacity: 1;
        }

        .accordion-icon {
            transition: transform 0.3s ease;
        }

        .accordion-icon.active {
            transform: rotate(180deg);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #fcfaf7;
        }
        ::-webkit-scrollbar-thumb {
            background: #d4a373;
            border-radius: 3px;
        }

        /* Fade-in Animation */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .animate-fade-in {
            animation: fadeIn 0.8s ease-out forwards;
        }

        /* Modal Backdrop */
        .modal-backdrop {
            background: rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(4px);
        }
    </style>
</head>
<body class="antialiased selection:bg-morandi-gold selection:text-white">

    <!-- Fixed Frosted Glass Navigation Bar -->
    <nav class="fixed top-0 left-0 right-0 z-50 glass-nav border-b border-morandi-gold/20 transition-all duration-300">
        <div class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center">
            <!-- Monogram / Couple Name -->
            <a href="#hero" class="text-xl sm:text-2xl font-english tracking-widest font-semibold text-morandi-dark hover:text-morandi-gold transition">
                LIN & WEI
            </a>
            
            <!-- Desktop Links -->
            <div class="hidden md:flex space-x-8 text-sm tracking-widest text-morandi-dark">
                <a href="#about" class="hover:text-morandi-gold transition duration-200 py-1 border-b-2 border-transparent hover:border-morandi-gold">關於我們</a>
                <a href="#details" class="hover:text-morandi-gold transition duration-200 py-1 border-b-2 border-transparent hover:border-morandi-gold">婚禮詳情</a>
                <a href="#rsvp" class="hover:text-morandi-gold transition duration-200 py-1 border-b-2 border-transparent hover:border-morandi-gold">出席回函</a>
            </div>

            <!-- Mobile Hamburger Button -->
            <button id="menu-btn" class="md:hidden text-morandi-dark focus:outline-none p-2" aria-label="Toggle Menu">
                <i class="fa-solid fa-bars text-xl"></i>
            </button>
        </div>

        <!-- Mobile Dropdown Menu -->
        <div id="mobile-menu" class="hidden md:hidden bg-white/95 backdrop-blur-md border-b border-morandi-gold/20 px-6 py-4 space-y-4 text-center">
            <a href="#about" class="block text-morandi-dark hover:text-morandi-gold tracking-widest py-2" onclick="closeMobileMenu()">關於我們</a>
            <a href="#details" class="block text-morandi-dark hover:text-morandi-gold tracking-widest py-2" onclick="closeMobileMenu()">婚禮詳情</a>
            <a href="#rsvp" class="block text-morandi-dark hover:text-morandi-gold tracking-widest py-2" onclick="closeMobileMenu()">出席回函</a>
        </div>
    </nav>

    <!-- Hero Section: Fullscreen Cover -->
    <section id="hero" class="relative min-h-screen flex items-center justify-center bg-cover bg-center text-white" style="background-image: url('https://i.postimg.cc/rmrJXfsS/365A0427-3.jpg');">
        <!-- Dark Subtle Overlay for High Readability -->
        <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/25 to-black/60"></div>
        
        <div class="relative z-10 text-center px-4 max-w-3xl mx-auto space-y-6 animate-fade-in mt-16">
            <p class="font-english tracking-widest text-lg sm:text-xl uppercase text-stone-200">
                We Are Getting Married
            </p>
            
            <h1 class="text-4xl sm:text-6xl font-light tracking-wider font-noto drop-shadow-md">
                林上軒 <span class="font-english text-3xl sm:text-5xl font-normal mx-1">&amp;</span> 徐瑋翎
            </h1>
            
            <!-- Soul Slogan / Subtitle -->
            <div class="pt-2 pb-4">
                <span class="inline-block px-5 py-1.5 rounded-full bg-white/20 backdrop-blur-md border border-white/30 text-xs sm:text-sm tracking-widest font-light text-stone-100 shadow-lg">
                    測試版
                </span>
            </div>

            <div class="w-16 h-[1px] bg-white/60 mx-auto my-4"></div>

            <p class="font-english text-2xl sm:text-3xl tracking-widest font-light">
                2026 . 11 . 22
            </p>
            <p class="text-sm sm:text-base tracking-widest font-light text-stone-200">
                SUNDAY AT 12:00 PM
            </p>

            <div class="pt-8">
                <a href="#rsvp" class="inline-block px-8 py-3 rounded-full bg-morandi-gold/90 hover:bg-morandi-gold text-white tracking-widest transition duration-300 shadow-lg hover:shadow-xl hover:-translate-y-0.5">
                    填寫出席回函
                </a>
            </div>
        </div>

        <!-- Down Scroll Arrow -->
        <a href="#countdown" class="absolute bottom-8 left-1/2 transform -translate-x-1/2 text-white/80 hover:text-white transition animate-bounce p-2">
            <i class="fa-solid fa-chevron-down text-xl"></i>
        </a>
    </section>

    <!-- Countdown Timer Section (Artistic Design) -->
    <section id="countdown" class="py-16 sm:py-24 px-4 bg-morandi-warmBg border-b border-morandi-gold/10">
        <div class="max-w-4xl mx-auto text-center space-y-8">
            <div class="space-y-2">
                <span class="font-english text-sm tracking-widest uppercase text-morandi-gold font-semibold">Countdown to the Big Day</span>
                <h2 class="text-2xl sm:text-3xl font-noto tracking-wider text-morandi-dark">距離攜手時刻</h2>
                <div class="w-10 h-[2px] bg-morandi-gold mx-auto mt-2"></div>
            </div>

            <!-- Soft Glow Cards Container -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6 pt-4">
                
                <!-- Days Card -->
                <div class="glow-card rounded-2xl p-4 sm:p-6 text-center transition hover:shadow-2xl hover:-translate-y-1">
                    <div class="flex items-center justify-between">
                        <div class="w-full">
                            <span id="days" class="block font-english text-4xl sm:text-5xl font-light text-morandi-dark leading-none">00</span>
                            <span class="block text-xs sm:text-sm font-noto text-morandi-sage mt-2 tracking-widest">天 DAYS</span>
                        </div>
                        <div class="hidden sm:block h-10 w-[1px] bg-morandi-gold/20 ml-2"></div>
                    </div>
                </div>

                <!-- Hours Card -->
                <div class="glow-card rounded-2xl p-4 sm:p-6 text-center transition hover:shadow-2xl hover:-translate-y-1">
                    <div class="flex items-center justify-between">
                        <div class="w-full">
                            <span id="hours" class="block font-english text-4xl sm:text-5xl font-light text-morandi-dark leading-none">00</span>
                            <span class="block text-xs sm:text-sm font-noto text-morandi-sage mt-2 tracking-widest">時 HOURS</span>
                        </div>
                        <div class="hidden sm:block h-10 w-[1px] bg-morandi-gold/20 ml-2"></div>
                    </div>
                </div>

                <!-- Minutes Card -->
                <div class="glow-card rounded-2xl p-4 sm:p-6 text-center transition hover:shadow-2xl hover:-translate-y-1">
                    <div class="flex items-center justify-between">
                        <div class="w-full">
                            <span id="minutes" class="block font-english text-4xl sm:text-5xl font-light text-morandi-dark leading-none">00</span>
                            <span class="block text-xs sm:text-sm font-noto text-morandi-sage mt-2 tracking-widest">分 MINUTES</span>
                        </div>
                        <div class="hidden sm:block h-10 w-[1px] bg-morandi-gold/20 ml-2"></div>
                    </div>
                </div>

                <!-- Seconds Card -->
                <div class="glow-card rounded-2xl p-4 sm:p-6 text-center transition hover:shadow-2xl hover:-translate-y-1">
                    <div class="w-full">
                        <span id="seconds" class="block font-english text-4xl sm:text-5xl font-light text-morandi-gold leading-none">00</span>
                        <span class="block text-xs sm:text-sm font-noto text-morandi-sage mt-2 tracking-widest">秒 SECONDS</span>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- About Us Section (Vertical V-Card Design) -->
    <section id="about" class="py-16 sm:py-24 px-4 bg-white">
        <div class="max-w-3xl mx-auto space-y-10">
            <div class="text-center space-y-2">
                <span class="font-english text-sm tracking-widest uppercase text-morandi-gold font-semibold">Groom &amp; Bride</span>
                <h2 class="text-2xl sm:text-3xl font-noto tracking-wider text-morandi-dark">關於我們</h2>
                <div class="w-10 h-[2px] bg-morandi-gold mx-auto mt-2"></div>
            </div>

            <!-- Vertical V-Card -->
            <div class="v-card p-6 sm:p-10 text-center relative overflow-hidden">
                <!-- Decorative Corner Accent -->
                <div class="absolute -top-10 -right-10 w-28 h-28 bg-morandi-sand rounded-full opacity-50"></div>
                <div class="absolute -bottom-10 -left-10 w-28 h-28 bg-morandi-lightSage rounded-full opacity-50"></div>

                <div class="relative z-10 space-y-8">
                    <!-- Groom and Bride Photo Avatar / Display -->
                    <div class="w-28 h-28 sm:w-36 sm:h-36 mx-auto rounded-full overflow-hidden border-4 border-morandi-sand shadow-md">
                        <img src="https://i.postimg.cc/rmrJXfsS/365A0427-3.jpg" alt="林上軒 & 徐瑋翎" class="w-full h-full object-cover">
                    </div>

                    <!-- Names & Intros -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 items-center">
                        <!-- Groom -->
                        <div class="p-4 rounded-xl bg-morandi-warmBg/80 border border-morandi-gold/10">
                            <span class="text-xs text-morandi-sage uppercase font-english tracking-widest">The Groom</span>
                            <h3 class="text-xl font-bold text-morandi-dark mt-1">林上軒 <span class="font-english font-normal text-sm text-morandi-gold">LIN</span></h3>
                            <p class="text-xs text-stone-500 mt-2 leading-relaxed">願與妳溫柔相伴，走過歲歲年年。</p>
                        </div>
                        <!-- Bride -->
                        <div class="p-4 rounded-xl bg-morandi-warmBg/80 border border-morandi-gold/10">
                            <span class="text-xs text-morandi-sage uppercase font-english tracking-widest">The Bride</span>
                            <h3 class="text-xl font-bold text-morandi-dark mt-1">徐瑋翎 <span class="font-english font-normal text-sm text-morandi-gold">WEI</span></h3>
                            <p class="text-xs text-stone-500 mt-2 leading-relaxed">因為有你，平淡的日子都綻放著光芒。</p>
                        </div>
                    </div>

                    <!-- Romantic Quote -->
                    <div class="pt-4 border-t border-stone-100">
                        <p class="font-noto italic text-sm sm:text-base text-stone-600 leading-loose">
                            「兩顆心的交會，是世界上最美好的奇蹟。<br>誠摯邀請您，見證我們最重要的幸福時刻。」
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Wedding Details & Transportation (Accordion) Section -->
    <section id="details" class="py-16 sm:py-24 px-4 bg-morandi-warmBg border-t border-morandi-gold/10">
        <div class="max-w-3xl mx-auto space-y-10">
            <div class="text-center space-y-2">
                <span class="font-english text-sm tracking-widest uppercase text-morandi-gold font-semibold">Wedding Information</span>
                <h2 class="text-2xl sm:text-3xl font-noto tracking-wider text-morandi-dark">婚禮詳情</h2>
                <div class="w-10 h-[2px] bg-morandi-gold mx-auto mt-2"></div>
            </div>

            <!-- Details Card -->
            <div class="v-card p-6 sm:p-10 space-y-8">
                
                <!-- Event Info Grid -->
                <div class="space-y-6">
                    <!-- Date & Time -->
                    <div class="flex items-start space-x-4">
                        <div class="w-10 h-10 rounded-full bg-morandi-sand flex items-center justify-center text-morandi-gold shrink-0 mt-1">
                            <i class="fa-regular fa-calendar-check text-lg"></i>
                        </div>
                        <div>
                            <h4 class="text-sm text-morandi-sage uppercase tracking-widest font-semibold">日期與時間 DATE &amp; TIME</h4>
                            <p class="text-lg font-bold text-morandi-dark mt-1">2026 年 11 月 22 日 星期日</p>
                            <p class="text-sm text-stone-600 mt-0.5">11:30 AM 迎賓入席 ｜ 12:00 PM 午宴開席</p>
                        </div>
                    </div>

                    <!-- Venue -->
                    <div class="flex items-start space-x-4">
                        <div class="w-10 h-10 rounded-full bg-morandi-sand flex items-center justify-center text-morandi-gold shrink-0 mt-1">
                            <i class="fa-solid fa-location-dot text-lg"></i>
                        </div>
                        <div>
                            <h4 class="text-sm text-morandi-sage uppercase tracking-widest font-semibold">婚宴地點 VENUE</h4>
                            <p class="text-lg font-bold text-morandi-dark mt-1">
                                <span class="whitespace-nowrap">台北喜來登大飯店</span> B2F <span class="whitespace-nowrap">壽喜廳</span>
                            </p>
                            <p class="text-sm text-stone-600 mt-0.5">
                                <span class="whitespace-nowrap">台北市中正區忠孝東路一段12號</span>
                            </p>
                        </div>
                    </div>

                    <!-- Dress Code -->
                    <div class="flex items-start space-x-4">
                        <div class="w-10 h-10 rounded-full bg-morandi-sand flex items-center justify-center text-morandi-gold shrink-0 mt-1">
                            <i class="fa-solid fa-shirt text-lg"></i>
                        </div>
                        <div>
                            <h4 class="text-sm text-morandi-sage uppercase tracking-widest font-semibold">穿著建議 DRESS CODE</h4>
                            <p class="text-base font-semibold text-morandi-dark mt-1">莫蘭迪暖陽色系 / 大地色調 / 輕正裝</p>
                            <div class="flex space-x-2 mt-2">
                                <span class="w-6 h-6 rounded-full inline-block border border-black/10" style="background-color: #d4a373;" title="暖陽金"></span>
                                <span class="w-6 h-6 rounded-full inline-block border border-black/10" style="background-color: #8da399;" title="鼠尾草綠"></span>
                                <span class="w-6 h-6 rounded-full inline-block border border-black/10" style="background-color: #f5ebe0;" title="燕麥奶"></span>
                                <span class="w-6 h-6 rounded-full inline-block border border-black/10" style="background-color: #e3d5ca;" title="杏棕色"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="w-full h-[1px] bg-stone-200"></div>

                <!-- Transportation Guidance Accordion (Collapsible) -->
                <div>
                    <h3 class="text-lg font-bold text-morandi-dark mb-4 flex items-center space-x-2">
                        <i class="fa-solid fa-compass text-morandi-gold"></i>
                        <span>交通指引 TRANSPORTATION</span>
                    </h3>

                    <div class="space-y-3">
                        
                        <!-- Accordion Item 1: MRT -->
                        <div class="border border-stone-200 rounded-xl overflow-hidden bg-stone-50/50">
                            <button class="w-full px-5 py-4 text-left flex justify-between items-center text-morandi-dark font-medium hover:bg-stone-100/60 transition" onclick="toggleAccordion('acc-mrt', 'icon-mrt')">
                                <span class="flex items-center space-x-3">
                                    <i class="fa-solid fa-train-subway text-morandi-sage"></i>
                                    <span>捷運搭乘方式 (MRT)</span>
                                </span>
                                <i id="icon-mrt" class="fa-solid fa-chevron-down text-stone-400 accordion-icon"></i>
                            </button>
                            <div id="acc-mrt" class="accordion-content px-5">
                                <div class="pb-4 pt-1 text-sm text-stone-600 space-y-2 border-t border-stone-200/60 mt-2">
                                    <p>搭乘捷運板南線（藍線）至 <span class="whitespace-nowrap font-semibold text-morandi-dark">捷運善導寺站</span>。</p>
                                    <p>由 <span class="whitespace-nowrap font-semibold text-morandi-dark">2 號出口</span> 出站後，步行約 1 分鐘即可抵達 <span class="whitespace-nowrap font-semibold text-morandi-dark">台北喜來登大飯店</span>。</p>
                                </div>
                            </div>
                        </div>

                        <!-- Accordion Item 2: Driving & Parking -->
                        <div class="border border-stone-200 rounded-xl overflow-hidden bg-stone-50/50">
                            <button class="w-full px-5 py-4 text-left flex justify-between items-center text-morandi-dark font-medium hover:bg-stone-100/60 transition" onclick="toggleAccordion('acc-parking', 'icon-parking')">
                                <span class="flex items-center space-x-3">
                                    <i class="fa-solid fa-square-parking text-morandi-sage"></i>
                                    <span>自行開車與停車資訊 (DRIVING)</span>
                                </span>
                                <i id="icon-parking" class="fa-solid fa-chevron-down text-stone-400 accordion-icon"></i>
                            </button>
                            <div id="acc-parking" class="accordion-content px-5">
                                <div class="pb-4 pt-1 text-sm text-stone-600 space-y-2 border-t border-stone-200/60 mt-2">
                                    <p>請導航至 <span class="whitespace-nowrap font-semibold text-morandi-dark">台北市中正區忠孝東路一段12號</span>。</p>
                                    <p>飯店提供地下停車場，參加婚宴賓客可至收禮桌領取折抵停車券。</p>
                                </div>
                            </div>
                        </div>

                        <!-- Accordion Item 3: Bus -->
                        <div class="border border-stone-200 rounded-xl overflow-hidden bg-stone-50/50">
                            <button class="w-full px-5 py-4 text-left flex justify-between items-center text-morandi-dark font-medium hover:bg-stone-100/60 transition" onclick="toggleAccordion('acc-bus', 'icon-bus')">
                                <span class="flex items-center space-x-3">
                                    <i class="fa-solid fa-bus text-morandi-sage"></i>
                                    <span>公車資訊 (BUS)</span>
                                </span>
                                <i id="icon-bus" class="fa-solid fa-chevron-down text-stone-400 accordion-icon"></i>
                            </button>
                            <div id="acc-bus" class="accordion-content px-5">
                                <div class="pb-4 pt-1 text-sm text-stone-600 space-y-2 border-t border-stone-200/60 mt-2">
                                    <p>公車站名：<span class="whitespace-nowrap font-semibold text-morandi-dark">捷運善導寺站</span>。</p>
                                    <p>可搭乘公車 205、212、262、276、299、600、忠孝幹線等路線抵達。</p>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Action Button for Google Maps -->
                <div class="pt-2 text-center">
                    <a href="https://maps.google.com/?q=台北喜來登大飯店" target="_blank" rel="noopener noreferrer" class="inline-flex items-center space-x-2 px-6 py-2.5 rounded-full border border-morandi-gold text-morandi-gold hover:bg-morandi-gold hover:text-white transition duration-300 text-sm tracking-wider">
                        <i class="fa-solid fa-map-location-dot"></i>
                        <span>開啟 Google 地圖導航</span>
                    </a>
                </div>

            </div>
        </div>
    </section>

    <!-- RSVP Section (Form with Bilingual Labels & Hidden Iframe Submit) -->
    <section id="rsvp" class="py-16 sm:py-24 px-4 bg-white">
        <div class="max-w-2xl mx-auto space-y-10">
            <div class="text-center space-y-2">
                <span class="font-english text-sm tracking-widest uppercase text-morandi-gold font-semibold">RSVP Form</span>
                <h2 class="text-2xl sm:text-3xl font-noto tracking-wider text-morandi-dark">出席回函</h2>
                <p class="text-xs sm:text-sm text-stone-500">請於婚禮前協助填寫回函，以便我們為您準備完美的宴席。</p>
                <div class="w-10 h-[2px] bg-morandi-gold mx-auto mt-2"></div>
            </div>

            <!-- Hidden Iframe Target for Form Submission without Page Refresh -->
            <iframe name="hidden_iframe" id="hidden_iframe" style="display:none;" onload="handleIframeLoad()"></iframe>

            <!-- RSVP Form -->
            <form action="https://docs.google.com/forms/d/e/1FAIpQLSeRL-Jxl7yafIKL4thJqwqJZyzehj4GSiEp6n_owk5WBYiNSg/formResponse" method="POST" target="hidden_iframe" id="wedding-form" onsubmit="handleFormSubmit(event)" class="v-card p-6 sm:p-10 space-y-6">
                
                <!-- Name -->
                <div>
                    <label for="entry_44710181" class="block text-sm font-semibold text-morandi-dark mb-2">
                        姓名 <span class="font-english text-xs text-morandi-sage uppercase">NAME</span> <span class="text-red-400">*</span>
                    </label>
                    <input type="text" id="entry_44710181" name="entry.44710181" required placeholder="請輸入您的真實姓名" class="w-full px-4 py-3 rounded-xl border border-stone-200 focus:border-morandi-gold focus:ring-2 focus:ring-morandi-gold/20 outline-none transition text-sm text-morandi-dark">
                </div>

                <!-- Email -->
                <div>
                    <label for="entry_1753262884" class="block text-sm font-semibold text-morandi-dark mb-2">
                        電子郵件 <span class="font-english text-xs text-morandi-sage uppercase">EMAIL</span> <span class="text-red-400">*</span>
                    </label>
                    <input type="email" id="entry_1753262884" name="entry.1753262884" required placeholder="example@email.com" class="w-full px-4 py-3 rounded-xl border border-stone-200 focus:border-morandi-gold focus:ring-2 focus:ring-morandi-gold/20 outline-none transition text-sm text-morandi-dark">
                </div>

                <!-- Relationship -->
                <div>
                    <label for="entry_1619546356" class="block text-sm font-semibold text-morandi-dark mb-2">
                        與新人關係 <span class="font-english text-xs text-morandi-sage uppercase">RELATIONSHIP</span> <span class="text-red-400">*</span>
                    </label>
                    <select id="entry_1619546356" name="entry.1619546356" required class="w-full px-4 py-3 rounded-xl border border-stone-200 focus:border-morandi-gold focus:ring-2 focus:ring-morandi-gold/20 outline-none transition text-sm text-morandi-dark bg-white">
                        <option value="" disabled selected>請選擇您與新人的關係</option>
                        <option value="新郎好友">新郎好友</option>
                        <option value="新娘好友">新娘好友</option>
                        <option value="男方親戚">男方親戚</option>
                        <option value="女方親戚">女方親戚</option>
                        <option value="男方長輩好友">男方長輩好友</option>
                        <option value="女方長輩好友">女方長輩好友</option>
                        <option value="共同好友">共同好友</option>
                    </select>
                </div>

                <!-- Attendance Count -->
                <div>
                    <label for="entry_768470855" class="block text-sm font-semibold text-morandi-dark mb-2">
                        出席人數 <span class="font-english text-xs text-morandi-sage uppercase">ATTENDANCE</span> <span class="text-red-400">*</span>
                    </label>
                    <input type="number" id="entry_768470855" name="entry.768470855" min="0" max="10" required placeholder="填寫 0 代表無法出席" oninput="toggleConditionalFields(this.value)" class="w-full px-4 py-3 rounded-xl border border-stone-200 focus:border-morandi-gold focus:ring-2 focus:ring-morandi-gold/20 outline-none transition text-sm text-morandi-dark">
                    <p class="text-xs text-stone-400 mt-1">如無法出席，請輸入 0</p>
                </div>

                <!-- Conditional Container (Shows only when Attendance > 0) -->
                <div id="conditional-fields" class="space-y-6 hidden border-l-2 border-morandi-gold/30 pl-4 py-2 my-2 transition-all duration-300">
                    
                    <!-- Dietary Preferences -->
                    <div>
                        <label for="entry_551562185" class="block text-sm font-semibold text-morandi-dark mb-2">
                            飲食需求 <span class="font-english text-xs text-morandi-sage uppercase">DIETARY</span>
                        </label>
                        <select id="entry_551562185" name="entry.551562185" class="w-full px-4 py-3 rounded-xl border border-stone-200 focus:border-morandi-gold focus:ring-2 focus:ring-morandi-gold/20 outline-none transition text-sm text-morandi-dark bg-white">
                            <option value="葷食">葷食</option>
                            <option value="素食">素食</option>
                            <option value="葷素皆有">葷素皆有</option>
                        </select>
                    </div>

                    <!-- Child Seat Needs -->
                    <div>
                        <label for="entry_615031120" class="block text-sm font-semibold text-morandi-dark mb-2">
                            兒童座椅需求 <span class="font-english text-xs text-morandi-sage uppercase">CHILD SEAT</span>
                        </label>
                        <select id="entry_615031120" name="entry.615031120" class="w-full px-4 py-3 rounded-xl border border-stone-200 focus:border-morandi-gold focus:ring-2 focus:ring-morandi-gold/20 outline-none transition text-sm text-morandi-dark bg-white">
                            <option value="不需要">不需要</option>
                            <option value="1張">1張</option>
                            <option value="2張">2張</option>
                            <option value="3張">3張</option>
                        </select>
                    </div>

                </div>

                <!-- Blessings / Words to Couple -->
                <div>
                    <label for="entry_1082579446" class="block text-sm font-semibold text-morandi-dark mb-2">
                        祝福的話 <span class="font-english text-xs text-morandi-sage uppercase">BLESSINGS</span>
                    </label>
                    <textarea id="entry_1082579446" name="entry.1082579446" rows="4" placeholder="寫下給新人的祝福與想說的話..." class="w-full px-4 py-3 rounded-xl border border-stone-200 focus:border-morandi-gold focus:ring-2 focus:ring-morandi-gold/20 outline-none transition text-sm text-morandi-dark resize-none"></textarea>
                </div>

                <!-- Submit Button -->
                <div class="pt-4 text-center">
                    <button type="submit" id="submit-btn" class="w-full sm:w-auto px-10 py-3.5 rounded-full bg-morandi-gold hover:bg-morandi-accentGold text-white font-medium tracking-widest transition duration-300 shadow-lg hover:shadow-xl">
                        確認送出回函
                    </button>
                </div>

            </form>
        </div>
    </section>

    <!-- Footer -->
    <footer class="py-10 bg-morandi-dark text-stone-300 text-center text-xs tracking-wider space-y-3">
        <p class="font-english text-sm tracking-widest text-morandi-gold">LIN &amp; WEI WEDDING 2026</p>
        <p class="text-stone-400">期待與您共享這個充滿愛與溫暖的喜悅時刻</p>
        <p class="text-stone-500 font-light pt-2">© 2026 All Rights Reserved.</p>
    </footer>

    <!-- Success Modal -->
    <div id="success-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 modal-backdrop opacity-0 pointer-events-none transition-opacity duration-300">
        <div class="bg-white rounded-2xl max-w-sm w-full p-6 text-center space-y-4 shadow-2xl border border-morandi-gold/20 transform scale-95 transition-transform duration-300" id="modal-content">
            <div class="w-14 h-14 rounded-full bg-morandi-lightSage text-morandi-sage flex items-center justify-center mx-auto text-2xl">
                <i class="fa-solid fa-heart"></i>
            </div>
            <h3 class="text-xl font-bold text-morandi-dark">感謝您的回覆！</h3>
            <p class="text-sm text-stone-600 leading-relaxed">您的出席資訊已成功記錄，我們非常期待在婚禮當天與您相見！</p>
            <div class="pt-2">
                <button onclick="closeSuccessModal()" class="w-full py-2.5 rounded-full bg-morandi-gold text-white font-medium hover:bg-morandi-accentGold transition shadow">
                    確定
                </button>
            </div>
        </div>
    </div>

    <script>
        // State tracking for submission
        let formSubmitted = false;

        // Mobile Menu Toggle
        const menuBtn = document.getElementById('menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');

        menuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        function closeMobileMenu() {
            mobileMenu.classList.add('hidden');
        }

        // Accordion Toggle
        function toggleAccordion(contentId, iconId) {
            const content = document.getElementById(contentId);
            const icon = document.getElementById(iconId);

            // Close all other accordions
            const allContents = document.querySelectorAll('.accordion-content');
            const allIcons = document.querySelectorAll('.accordion-icon');

            allContents.forEach(item => {
                if (item.id !== contentId) {
                    item.classList.remove('active');
                }
            });

            allIcons.forEach(item => {
                if (item.id !== iconId) {
                    item.classList.remove('active');
                }
            });

            // Toggle target accordion
            content.classList.toggle('active');
            icon.classList.toggle('active');
        }

        // Smart Form Logic: Show/Hide Dietary & Child Seat fields based on Attendance Count
        function toggleConditionalFields(val) {
            const count = parseInt(val, 10);
            const conditionalFields = document.getElementById('conditional-fields');

            if (!isNaN(count) && count > 0) {
                conditionalFields.classList.remove('hidden');
            } else {
                conditionalFields.classList.add('hidden');
            }
        }

        // Form Submit Handler
        function handleFormSubmit(e) {
            formSubmitted = true;
            const submitBtn = document.getElementById('submit-btn');
            submitBtn.innerText = '處理中...';
            submitBtn.disabled = true;
        }

        // Hidden Iframe Load Handler
        function handleIframeLoad() {
            if (formSubmitted) {
                // Show Success Modal
                const modal = document.getElementById('success-modal');
                const modalContent = document.getElementById('modal-content');
                
                modal.classList.remove('opacity-0', 'pointer-events-none');
                modalContent.classList.remove('scale-95');
                modalContent.classList.add('scale-100');

                // Reset Form
                document.getElementById('wedding-form').reset();
                toggleConditionalFields(0);

                // Reset button
                const submitBtn = document.getElementById('submit-btn');
                submitBtn.innerText = '確認送出回函';
                submitBtn.disabled = false;

                formSubmitted = false;
            }
        }

        function closeSuccessModal() {
            const modal = document.getElementById('success-modal');
            const modalContent = document.getElementById('modal-content');

            modal.classList.add('opacity-0', 'pointer-events-none');
            modalContent.classList.remove('scale-100');
            modalContent.classList.add('scale-95');
        }

        // Countdown Timer Logic
        // Wedding Date: Nov 22, 2026, 12:00:00 PM
        const weddingDate = new Date('2026-11-22T12:00:00').getTime();

        function updateCountdown() {
            const now = new Date().getTime();
            const difference = weddingDate - now;

            if (difference > 0) {
                const days = Math.floor(difference / (1000 * 60 * 60 * 24));
                const hours = Math.floor((difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((difference % (1000 * 60)) / 1000);

                document.getElementById('days').innerText = String(days).padStart(2, '0');
                document.getElementById('hours').innerText = String(hours).padStart(2, '0');
                document.getElementById('minutes').innerText = String(minutes).padStart(2, '0');
                document.getElementById('seconds').innerText = String(seconds).padStart(2, '0');
            } else {
                document.getElementById('days').innerText = '00';
                document.getElementById('hours').innerText = '00';
                document.getElementById('minutes').innerText = '00';
                document.getElementById('seconds').innerText = '00';
            }
        }

        // Initialize Countdown on window load
        window.onload = function() {
            updateCountdown();
            setInterval(updateCountdown, 1000);
        };
    </script>
</body>
</html>
